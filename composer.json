{
    "name": "adhocrat-io/arkhe-main",
    "description": "Bootstrap a Laravel backend with users, roles and permissions management on Flux UI.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "livewire",
        "flux",
        "admin",
        "users",
        "roles",
        "permissions",
        "arkhe"
    ],
    "authors": [
        {
            "name": "Luc",
            "email": "luc@adhocrat.io"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^12.0 || ^13.0",
        "livewire/flux": "^2.1",
        "livewire/livewire": "^4.2",
        "ralphjsmit/laravel-seo": "^1.8",
        "spatie/laravel-package-tools": "^1.93",
        "spatie/laravel-permission": "^7.0",
        "spatie/laravel-sitemap": "^8.0",
        "whitecube/laravel-cookie-consent": "^1.3"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Arkhe\\Main\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Arkhe\\Main\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Arkhe\\Main\\ArkheMainServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
